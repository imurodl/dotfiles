{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 8,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": ["custom/updates", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "battery", "network", "cpu", "memory", "tray"],

    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "interval": 600,
        "format": "{}",
        "on-click": "~/.config/waybar/scripts/updates.sh",
        "signal": 8
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "all-outputs": true,
        "active-only": false
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%A, %B %d, %Y}"
    },

    "battery": {
        "format": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },

    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid}"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟 MUTE",
        "on-click": "pkill pavucontrol || pavucontrol"
    },

    "cpu": {
        "format": "󰓅 {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "󰍛 {used:0.1f}G/{total:0.1f}G",
        "interval": 2
    },

    "tray": {
        "spacing": 8
    }
}

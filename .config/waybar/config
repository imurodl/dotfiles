{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 8,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": ["custom/updates", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "battery", "network", "bluetooth", "temperature", "cpu", "memory", "tray", "custom/power"],

    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "interval": 600,
        "format": "{}",
        "on-click": "~/.config/waybar/scripts/updates.sh",
        "signal": 8
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "all-outputs": true,
        "active-only": false
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%A, %B %d, %Y}"
    },

    "battery": {
        "format": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "on-click": "~/.config/waybar/scripts/battery-stats.sh"
    },

    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid}",
        "on-click": "pkill iwgtk || iwgtk"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟 MUTE",
        "on-click": "pkill pavucontrol || pavucontrol"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {device_battery_percentage}%",
        "format-off": "󰂲",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "pkill blueman-manager || blueman-manager"
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
        "format": "󰔏 {temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": "󰔏 {temperatureC}°C",
        "interval": 5
    },

    "cpu": {
        "format": "󰓅 {usage}%",
        "interval": 2,
        "on-click": "pkill htop || ghostty -e htop"
    },

    "memory": {
        "format": "󰍛 {used:0.1f}G/{total:0.1f}G",
        "interval": 2,
        "on-click": "pkill htop || ghostty -e htop"
    },

    "tray": {
        "spacing": 8
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    }
}

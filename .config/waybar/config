{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 8,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "battery", "network", "cpu", "memory", "tray"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "all-outputs": true,
        "active-only": false
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%A, %B %d, %Y}"
    },

    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "CHG {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },

    "network": {
        "format-wifi": "WiFi {signalStrength}%",
        "format-ethernet": "ETH",
        "format-disconnected": "OFF",
        "tooltip-format-wifi": "{essid}"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "on-click": "pavucontrol"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "RAM {used:0.1f}G/{total:0.1f}G",
        "interval": 2
    },

    "tray": {
        "spacing": 8
    }
}
